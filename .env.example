# Copy this file to ".env" and fill it in. The server reads .env at start.

# Access code for people who build and validate cabinets (Studio).
# If you leave it empty, the server makes one, prints it at start and keeps it in data/editor-code.txt.
EDITOR_CODE=

# Access code for technicians (Field view, read-only). Leave empty to allow editors only.
VIEWER_CODE=

# Claude API key, used for detecting components, reading drawings and "Ask Claude".
# Without it the app still works, but everything is entered by hand.
ANTHROPIC_API_KEY=

# The PLC of each machine is set in the Studio (open the machine, Machine settings).
# PLC_HOST and the lines below are only read once, when the server is updated to machines: they go to the first machine.
# Rack and slot: S7-300 and ET 200S CPU: rack 0, slot 2. S7-400: slot of the CPU. S7-1200/1500: rack 0, slot 1 (or 0).
# Check the PLCs with: node server.js --test-plc
PLC_HOST=
# PLC_RACK=0
# PLC_SLOT=2
# PLC_PORT=102

# Port the server listens on.
PORT=8080

# HTTPS for the local network, needed to install the app on phones. The server makes its own certificate
# (kept in the data folder, "tls"); each phone trusts it once, see http://<this computer>:PORT/install
# HTTPS_PORT=8443
# Extra names or IP addresses the phones use to reach this computer, comma separated (its own IPs are added).
# TLS_NAMES=cabinets.plant.local

# Folder for cabinets, drawings and images. Back this folder up.
# DATA_DIR=./data

# Set to 1 when the server sits behind a reverse proxy or a hosting platform that adds HTTPS.
# TRUST_PROXY=1

# If this server reaches the internet through a proxy, give its address here.
# With a user name and password: http://user:password@proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# Optional: choose the Claude models. "complex" reads drawings, "default" does the rest.
# AI_MODEL=claude-sonnet-5-5
# AI_MODEL_COMPLEX=claude-opus-5-5
# AI_MODEL_QUICK=claude-haiku-4-5-20251001

# Optional: the most Claude requests the server sends per hour, as a cost guard.
# AI_MAX_PER_HOUR=200

# Machine log: how many days are kept (1 to 30)
LOG_DAYS=4

# Reset from the phone (Drives page): 1 allows this server to write the reset request bit of a machine.
# Each machine then needs its reset bit and its reset code, set in the Studio (Machine settings). The PLC program must take the bit:
# see README, "Reset from the phone".
# ALLOW_RESET=1
# Reset is refused through the internet (a Cloudflare tunnel or another proxy): only on the plant network. 1 allows it from anywhere (not advised).
# RESET_FROM_INTERNET=1
